# IBM Bob API — used only for runbook generation. Only the key is required.
BOB_API_KEY=
# BOB_API_URL=https://api.us-east.bob.ibm.com/inference/v1
# BOB_MODEL=premium
# Bob 2.x accounts: routing ids from your Bob account (sent as x-instance-id / x-team-id)
# BOB_INSTANCE_ID=
# BOB_TEAM_ID=
# BOB_AUTH_SCHEME=Apikey
# BOB_TIMEOUT_SECONDS=60
